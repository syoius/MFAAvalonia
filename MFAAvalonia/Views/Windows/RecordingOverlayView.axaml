<Window
    x:Class="MFAAvalonia.Views.Windows.RecordingOverlayView"
    x:DataType="vm:RecordTaskViewModel"
    Width="400"
    CanResize="False"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SystemDecorations="None"
    Topmost="True"
    TransparencyLevelHint="None"
    Background="#00000000"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:suki="https://github.com/kikipoulet/SukiUI"
    xmlns:vm="clr-namespace:MFAAvalonia.ViewModels.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d">

	    <Border
	        Background="{DynamicResource SukiGlassCardBackground}"
	        BorderBrush="{DynamicResource SukiControlBorderBrush}"
	        BorderThickness="1"
	        CornerRadius="10"
	        Padding="10">
	        <StackPanel Spacing="10">
	            <Border PointerPressed="OnDragPointerPressed" Background="Transparent" Cursor="SizeAll">
	                <StackPanel>
	                    <TextBlock Text="录制作业悬浮窗" FontWeight="Bold" Foreground="{DynamicResource SukiText}" />
	                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
	                </StackPanel>
	            </Border>

	            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
	                <Button Width="140" Content="上一回合" Command="{Binding PrevRoundCommand}" />
	                <TextBlock Text="{Binding RoundDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource SukiLowText}" />
	                <Button Width="140" Content="下一回合" Command="{Binding NextRoundCommand}" />
	            </StackPanel>

            <ItemsControl ItemsSource="{Binding AvailableActions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="74" ItemHeight="34" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActionButtonItem">
                        <Button
                            Content="{Binding DisplayName}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding CommandParameter}"
                            Padding="6,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

	            <Separator />

	            <suki:GroupBox>
	                <suki:GroupBox.Header>
	                    <StackPanel Orientation="Horizontal" Spacing="8">
	                        <TextBlock FontSize="11"
	                                   FontWeight="Bold"
	                                   Foreground="{DynamicResource SukiLowText}"
	                                   Margin="2,0,0,0"
	                                   Text="当前录制"
	                                   VerticalAlignment="Center" />
	                        <TextBlock Text="{Binding RoundDisplay}"
	                                   FontSize="11"
	                                   Foreground="{DynamicResource SukiLowText}"
	                                   Opacity="0.8"
	                                   VerticalAlignment="Center" />
	                    </StackPanel>
	                </suki:GroupBox.Header>
	                <ListBox ItemsSource="{Binding RecordedSteps}" MaxHeight="260">
	                    <ListBox.ItemTemplate>
	                        <DataTemplate x:DataType="vm:RecordedStepItem">
	                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,2,0,2">
	                                <TextBlock Grid.Column="0" Text="{Binding Index}" Width="34" Opacity="0.8" />
	                                <TextBlock Grid.Column="1" Text="{Binding ActionName}" />
	                                <Button Grid.Column="2"
	                                        x:CompileBindings="False"
	                                        Content="删除"
	                                        Margin="8,0,0,0"
	                                        Padding="8,0"
	                                        Command="{Binding DataContext.DeleteRecordedStepCommand, RelativeSource={RelativeSource AncestorType=Window}}"
	                                        CommandParameter="{Binding}" />
	                            </Grid>
	                        </DataTemplate>
	                    </ListBox.ItemTemplate>
	                </ListBox>
	            </suki:GroupBox>

	            <Separator />

	            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
	                <Button Content="保存并结束" Command="{Binding SaveAndStopRecordingCommand}" IsEnabled="{Binding CanSave}" />
	                <Button Content="结束" Command="{Binding StopRecordingCommand}" />
	            </StackPanel>
        </StackPanel>
    </Border>
</Window>
