<Window
    x:Class="MFAAvalonia.Views.Windows.RecordingOverlayView"
    x:DataType="vm:RecordTaskViewModel"
    Width="400"
    CanResize="False"
    ShowInTaskbar="False"
    SizeToContent="Height"
    SystemDecorations="None"
    Topmost="True"
    TransparencyLevelHint="None"
    Background="#00000000"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:MFAAvalonia.ViewModels.Pages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d">

    <Border
        Background="{DynamicResource SukiGlassCardBackground}"
        BorderBrush="{DynamicResource SukiControlBorderBrush}"
        BorderThickness="1"
        CornerRadius="10"
        Padding="10">
        <StackPanel Spacing="10">
            <Border PointerPressed="OnDragPointerPressed">
                <StackPanel>
                    <TextBlock Text="录制作业悬浮窗" FontWeight="Bold" Foreground="{DynamicResource SukiText}" />
                    <TextBlock Text="{Binding Status}" FontSize="12" Foreground="{DynamicResource SukiLowText}" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Width="56" Content="上一" Command="{Binding PrevRoundCommand}" />
                <TextBlock Text="{Binding RoundDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource SukiLowText}" />
                <Button Width="56" Content="下一" Command="{Binding NextRoundCommand}" />
                <Button Content="+回合" Command="{Binding AddRoundCommand}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding AvailableActions}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="74" ItemHeight="34" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActionButtonItem">
                        <Button
                            Content="{Binding DisplayName}"
                            Command="{Binding Command}"
                            CommandParameter="{Binding CommandParameter}"
                            Padding="6,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Separator />

            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Content="保存" Command="{Binding SaveRecordingCommand}" IsEnabled="{Binding CanSave}" />
                <Button Content="结束" Command="{Binding StopRecordingCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
